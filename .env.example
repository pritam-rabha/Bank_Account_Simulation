# Reference list of settings. BankSim reads real environment variables;
# it does NOT load a .env file automatically (export them, or set them in Render).
#   Ubuntu:   set -a; source .env; set +a
#   Windows:  PowerShell  $env:NAME="value"   (see README)

# --- required in production -------------------------------------------------
BANKSIM_ENV=development            # set to "production" on Render
SECRET_KEY=change-me-to-a-long-random-string   # python -c "import secrets; print(secrets.token_hex(32))"

# --- PIN security -----------------------------------------------------------
PIN_PEPPER=                        # optional server-side secret mixed into PIN hashes (changing it invalidates all PINs)
PIN_MIN_LENGTH=4
PIN_MAX_LENGTH=6
MAX_FAILED_ATTEMPTS=5              # wrong PINs per account before lockout
IP_MAX_FAILED_ATTEMPTS=20          # wrong PINs per client IP before lockout
FAILURE_WINDOW_MINUTES=15
LOCKOUT_MINUTES=15
SESSION_MINUTES=15                 # idle session timeout
SESSION_COOKIE_SECURE=false        # defaults to true when BANKSIM_ENV=production
TRUST_PROXY=false                  # true behind Render/nginx so client IPs are correct

# --- storage and demo data --------------------------------------------------
DATA_FILE=data/bank_data.json
SEED_SAMPLE_DATA=true              # load fictional demo accounts when the data file is empty
SHOW_DEMO_CREDENTIALS=true         # show demo account numbers/PINs on the login page

# --- account rules (simulated) ----------------------------------------------
SAVINGS_INTEREST_RATE=4.00         # % per year, simple interest
CURRENT_INTEREST_RATE=0.00         # 0 = current accounts earn nothing
SAVINGS_MIN_BALANCE=500.00
SAVINGS_MIN_OPENING=500.00
CURRENT_MIN_OPENING=1000.00
FD_MIN_OPENING=1000.00
FD_RATES=6:6.00,12:6.50,24:6.75,36:7.00,60:7.25   # months:percent
MAX_TRANSACTION_AMOUNT=1000000.00

# --- display ------------------------------------------------------------------
DISPLAY_TIMEZONE=Asia/Kolkata
PER_PAGE=10

# --- local dev server (python run.py) -------------------------------------------
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=0
